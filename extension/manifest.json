{
  "manifest_version": 3,
  "name": "KeyLib",
  "version": "0.2.0",
  "description": "用本机KeyLib在当前 HTTPS 页面匹配、填写和保存账号。",
  "minimum_chrome_version": "110",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KeyLib"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+C"
      }
    }
  }
}
